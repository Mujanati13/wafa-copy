# Docker Compose Environment Variables
# These are used by docker-compose.yml to configure services
# IMPORTANT: Fill in your actual credentials before deploying

# MongoDB Credentials
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme123
MONGO_AUTO_INDEX=false

# Backend Secrets (CHANGE THESE!)
SESSION_SECRET=your_very_secure_session_secret_change_this
JWT_SECRET=your_very_secure_jwt_secret_change_this
# Account lease inactivity timeout in milliseconds (default: 30 minutes)
SINGLE_SESSION_TTL_MS=1800000
# Refresh an active account lease only inside this expiry window (default: 5 minutes)
SINGLE_SESSION_REFRESH_WINDOW_MS=300000
# Production request diagnostics
REQUEST_LOGGING=false
AUTH_FAILURE_LOGGING=false
SLOW_REQUEST_THRESHOLD_MS=1000

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
ADMIN_EMAIL=admin@yourqcm.online
# Used only by `docker compose exec backend npm run seed:admin`.
ADMIN_SEED_EMAIL=admin@yourqcm.online
ADMIN_SEED_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_ADMIN_PASSWORD
ADMIN_SEED_NAME=YourQCM Administrator

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

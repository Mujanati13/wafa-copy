# Copy this file to .env on the VPS. Do not reuse production-one values.
# docker compose reads this file; it must remain private (chmod 600 .env).

# A unique Compose project prevents container, network, and volume collisions.
COMPOSE_PROJECT_NAME=wafa-copy
# Existing shared reverse-proxy network on this VPS.
PROXY_NETWORK=wafa_wafa-network

# Nginx on the VPS terminates HTTPS and proxies to this private port.
APP_PORT=8081
APP_HOST_BIND=127.0.0.1
FRONTEND_URL=https://yourqcm.online
CORS_ORIGIN=https://yourqcm.online

# HTTPS is required for the public domain configuration.
COOKIE_SECURE=true
# Share secure auth cookies between the frontend and API subdomain.
COOKIE_DOMAIN=.yourqcm.online

# A separate MongoDB instance and Docker volumes for this copy.
MONGO_ROOT_USERNAME=wafa_copy_admin
MONGO_ROOT_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
MONGO_DATABASE=wafa_copy
# URL-encode the password here if it contains URI-reserved characters.
MONGO_URL=mongodb://wafa_copy_admin:REPLACE_WITH_A_LONG_UNIQUE_PASSWORD@mongodb:27017/wafa_copy?authSource=admin
MONGO_AUTO_INDEX=false

# Generate each with: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_UNIQUE_SESSION_SECRET
JWT_SECRET=REPLACE_WITH_A_UNIQUE_JWT_SECRET
# Account lease inactivity timeout in milliseconds (default: 6 hours)
SINGLE_SESSION_TTL_MS=21600000
SINGLE_SESSION_REFRESH_WINDOW_MS=300000

# Production request diagnostics. Slow requests still log at the threshold.
REQUEST_LOGGING=false
AUTH_FAILURE_LOGGING=false
SLOW_REQUEST_THRESHOLD_MS=1000

# Optional integrations. Enter values only if this copy should use them.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=
ADMIN_EMAIL=admin@yourqcm.online
# Used only by `docker compose exec backend npm run seed:admin`.
# Generate a strong unique value; do not commit the real password.
ADMIN_SEED_EMAIL=admin@yourqcm.online
ADMIN_SEED_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_ADMIN_PASSWORD
ADMIN_SEED_NAME=Atlas QCM Administrator
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://backend.yourqcm.online/api/v1/auth/google/callback
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=

# Built into the static frontend at build time. Keep these relative unless you
# deliberately expose the backend on a separate public URL.
VITE_API_URL=/api/v1
VITE_BASED_URL=/api/v1
